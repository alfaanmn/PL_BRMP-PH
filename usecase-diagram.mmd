        UC08(["Membatalkan Pengajuan Magang"]):::usecase
        UC09(["Mengunduh Surat<br/>Keterangan / Balasan"]):::usecase
        UC10(["Mengisi Survei Kepuasan<br/>Masyarakat (SKM)"]):::usecase

        %% Use Case Administrator
        UC11(["Mengelola Data Bidang Magang"]):::usecase
