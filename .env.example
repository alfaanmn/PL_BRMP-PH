# ==========================================
# SIM-MAGANG - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Salin file ini menjadi `.env.local` dan isi dengan konfigurasi asli dari Supabase & Google SMTP.
# JANGAN pernah membagikan atau meng-commit file `.env.local` yang berisi secret key!

# 1. Supabase Public Config (Dapat diakses di Client & Server)
# Ditemukan di: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# 2. Supabase Secret Config (HANYA untuk Server-Side / Service Role - RAHASIA)
# Ditemukan di: Supabase Dashboard -> Project Settings -> API -> service_role key
# Catatan: Kode mendukung SUPABASE_SERVICE_ROLE_KEY atau fallback SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_secret_key

# 3. Application Base URL (Single Source of Truth)
# - .env.local  -> http://localhost:3000
# - Production  -> https://simpul-brmpph.id (tanpa trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Email Notification (Gmail SMTP - Server-Side Only - RAHASIA)
# - GMAIL_USER: Alamat email pengirim Gmail resmi (harus berformat email valid)
# - GMAIL_APP_PASSWORD: 16 karakter Google App Password (tanpa spasi)
# - EMAIL_FROM: Format nama dan email pengirim, contoh: "SIMPUL BRMP-PH <simpulbrmpph@gmail.com>"
# - ADMIN_EMAIL: Alamat email penerima notifikasi admin (fallback ke GMAIL_USER jika kosong)
GMAIL_USER=simpulbrmpph@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
EMAIL_FROM="SIMPUL BRMP-PH <simpulbrmpph@gmail.com>"
ADMIN_EMAIL=simpulbrmpph@gmail.com

# 5. Vercel Cron Job Security
# Token keamanan untuk melindungi route /api/cron/check-magang-selesai
CRON_SECRET=your-random-cron-secret-token
