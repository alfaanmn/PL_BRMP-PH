# ==========================================
# SIM-MAGANG - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Salin file ini menjadi `.env.local` dan isi dengan konfigurasi asli dari Supabase Dashboard.
# JANGAN pernah membagikan atau meng-commit file `.env.local` yang berisi secret key!

# 1. Supabase Public Config (Dapat diakses di Client & Server)
# Ditemukan di: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Secret Config (HANYA untuk Server-Side / Service Role - RAHASIA)
# Ditemukan di: Supabase Dashboard -> Project Settings -> API -> service_role key
# PERINGATAN: Jangan gunakan prefix NEXT_PUBLIC_ untuk key ini!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
